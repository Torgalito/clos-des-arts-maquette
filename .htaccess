# Clos des Arts — maquette interactive
# Le HTML est toujours revalidé : remplacer index.html suffit à publier une mise à jour,
# sans purge ni changement d'URL dans Webflow. Photos et polices sont figées pour un an
# (leurs noms ne changent pas ; si vous remplacez une photo, renommez-la 1b.webp, etc.).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
DirectoryIndex index.html
